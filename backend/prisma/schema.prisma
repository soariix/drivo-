generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  vehicles  Vehicle[]
}

model Vehicle {
  id              String   @id @default(uuid())
  plate           String
  renavam         String
  chassis         String
  brand           String
  model           String
  manufactureYear Int
  modelYear       Int
  color           String
  fuel            String
  type            String
  nickname        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, plate])
  @@index([userId])
}